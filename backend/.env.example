# SAARTHI Backend Environment Configuration

# Core Application Settings
PROJECT_NAME="SAARTHI API"
VERSION="0.1.0"
API_V1_STR="/api/v1"
ENVIRONMENT="development"

# CORS Configuration
# Provide as a JSON list (e.g. ["http://localhost:3000"]) or comma-separated origins
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000","http://127.0.0.1:8000"]

# Credentials flag: Set to true only if CORS_ORIGINS explicitly lists allowed domains (no "*")
CORS_ALLOW_CREDENTIALS=False

# Google Gemini API Configuration
# Get your API key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash"
